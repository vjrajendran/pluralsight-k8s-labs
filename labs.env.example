# cp labs.env.example labs.env   (labs.env is git-ignored - never commit keys)
#
# Each morning: start the Pluralsight sandboxes, paste each one's access key
# and secret below, then run ./up.sh

REGION=us-east-1          # Pluralsight allows us-east-1 and us-west-2
CLUSTERS_PER_LAB=3        # 1-3 (9 EC2 instances per sandbox, 3 per cluster)

LAB1_AWS_ACCESS_KEY_ID=
LAB1_AWS_SECRET_ACCESS_KEY=

LAB2_AWS_ACCESS_KEY_ID=
LAB2_AWS_SECRET_ACCESS_KEY=

LAB3_AWS_ACCESS_KEY_ID=
LAB3_AWS_SECRET_ACCESS_KEY=

# Optional per-lab override, e.g. if a sandbox already has other instances
# LAB2_CLUSTERS=1
